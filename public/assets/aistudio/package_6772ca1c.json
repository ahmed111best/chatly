{
  "name": "chatly",
  "private": true,
  "description": "Chatly (شاتلي) - Premium Next-Generation Messaging Platform",
  "version": "1.0.0",
  "workspaces": [
    "apps/backend",
    "apps/web",
    "apps/desktop",
    "packages/shared"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:web": "npm run dev --workspace=apps/web",
    "db:start": "node scripts/dev-db.mjs",
    "db:migrate": "npm run migrate --workspace=apps/backend",
    "db:backup": "npm run db:backup --workspace=apps/backend",
    "db:restore-test": "npm run db:restore-test --workspace=apps/backend",
    "build": "npm run build --workspace=apps/backend && npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/backend",
    "setup": "npm install"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "embedded-postgres": "^19.0.0-beta.20",
    "playwright-core": "^1.65.1"
  }
}
