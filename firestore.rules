          incoming().updatedAt == request.time;
        allow update: if isValidId(uid) && isValidId(sessionId) && isVerifiedUser() && isOwner(uid) &&
          isValidDeviceSession(incoming()) &&
          incoming().id == existing().id &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['revoked', 'lastActiveAt', 'updatedAt']);
        allow delete: if isValidId(uid) && isValidId(sessionId) && isVerifiedUser() && isOwner(uid);
      }

      match /contacts/{targetUid} {
        allow get: if isValidId(uid) && isValidId(targetUid) && isOwner(uid);
