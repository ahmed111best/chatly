        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['deviceId', 'algorithm', 'publicKeyJwk', 'updatedAt']);
      allow delete: if isValidId(uid) && isVerifiedUser() && isOwner(uid);
    }

    // 8. Real-Time Conversations & Messages
    match /conversations/{convId} {
      allow get: if isValidId(convId) && isSignedIn() && (
        request.auth.uid in existing().memberUids ||
        (existing().type == 'group' && existing().inviteCode != '')
      );
      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids ||
        (resource.data.type == 'group' && resource.data.inviteCode is string)
      );
      allow create: if isValidId(convId) && isVerifiedUser() &&
        isValidConversation(incoming()) &&
        incoming().id == convId &&
        incoming().creatorUid == request.auth.uid &&
        request.auth.uid in incoming().memberUids &&
        (incoming().type != 'direct' || (incoming().memberUids.size() >= 1 && incoming().memberUids.size() <= 2)) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(convId) && isVerifiedUser() &&
        isValidConversation(incoming()) &&
        incoming().id == existing().id &&
        incoming().type == existing().type &&
        incoming().creatorUid == existing().creatorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().type != 'direct' || incoming().memberUids == existing().memberUids) &&
        (
          (
            request.auth.uid in existing().memberUids &&
            incoming().diff(existing()).affectedKeys().hasOnly(['lastMessagePreview', 'lastMessageAtMs', 'updatedAt'])
          ) ||
          (
            existing().creatorUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'memberUids', 'approvalRequired', 'announcementsOnly',
              'lastMessagePreview', 'lastMessageAtMs', 'updatedAt'
            ])
          ) ||
          (
            existing().type == 'group' &&
            existing().approvalRequired == false &&
            existing().inviteCode != '' &&
            request.auth.uid in incoming().memberUids &&
            incoming().memberUids.hasAll(existing().memberUids) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
          )
        );
      allow delete: if isValidId(convId) && isVerifiedUser() && existing().creatorUid == request.auth.uid;

      match /members/{memberUid} {
        allow get: if isValidId(convId) && isValidId(memberUid) && isConvMemberByParent(convId);
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;
        allow create: if isValidId(convId) && isValidId(memberUid) && isVerifiedUser() &&
          isValidConversationMember(incoming()) &&
          incoming().uid == memberUid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (isConvMemberByParent(convId) || memberUid == request.auth.uid);
        allow update: if isValidId(convId) && isValidId(memberUid) && isVerifiedUser() &&
          isConvMemberByParent(convId) &&
          isValidConversationMember(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/conversations/$(convId)).data.creatorUid == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']);
        allow delete: if isValidId(convId) && isValidId(memberUid) && isVerifiedUser() &&
          isConvMemberByParent(convId) &&
          (memberUid == request.auth.uid ||
            get(/databases/$(database)/documents/conversations/$(convId)).data.creatorUid == request.auth.uid);
      }

      match /messages/{msgId} {
        allow get: if isValidId(convId) && isValidId(msgId) && isConvMemberByParent(convId);
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;
        allow create: if isValidId(convId) && isValidId(msgId) && isVerifiedUser() &&
          isValidMessage(incoming()) &&
          incoming().id == msgId &&
          incoming().conversationId == convId &&
          incoming().senderUid == request.auth.uid &&
          request.auth.uid in incoming().memberUids &&
          incoming().memberUids == get(/databases/$(database)/documents/conversations/$(convId)).data.memberUids &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isConvMemberByParent(convId);
        allow update: if isValidId(convId) && isValidId(msgId) && isVerifiedUser() &&
          isValidMessage(incoming()) &&
          incoming().id == existing().id &&
          incoming().clientMessageId == existing().clientMessageId &&
          incoming().conversationId == existing().conversationId &&
          incoming().senderUid == existing().senderUid &&
          incoming().memberUids == existing().memberUids &&
          incoming().createdAtMs == existing().createdAtMs &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isConvMemberByParent(convId) &&
          (
            (
              existing().senderUid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['body', 'edited', 'deleted', 'updatedAt'])
            ) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'pinned', 'starredByUids', 'readByUids', 'updatedAt'])
          );
        allow delete: if isValidId(convId) && isValidId(msgId) && isVerifiedUser() &&
          isConvMemberByParent(convId) && existing().senderUid == request.auth.uid;
      }

      match /typing/{uid} {
        allow get: if isValidId(convId) && isValidId(uid) && isConvMemberByParent(convId);
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;
        allow create, update: if isValidId(convId) && isValidId(uid) && isVerifiedUser() &&
          isOwner(uid) &&
