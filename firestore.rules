    // 9. Media Library
    match /media/{mediaId} {
      allow get: if isValidId(mediaId) && isSignedIn() &&
        (existing().uploaderUid == request.auth.uid || request.auth.uid in existing().allowedUids);
      allow list: if isSignedIn() &&
        (resource.data.uploaderUid == request.auth.uid || request.auth.uid in resource.data.allowedUids);
      allow create: if isValidId(mediaId) && isVerifiedUser() &&
