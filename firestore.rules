    // 7. E2EE Public Key Directory
    match /e2eeKeys/{uid} {
      allow get: if isValidId(uid) && isSignedIn();
      allow list: if isSignedIn() && resource.data.uid is string;
      allow create: if isValidId(uid) && isVerifiedUser() && isOwner(uid) &&
