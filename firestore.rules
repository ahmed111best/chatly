        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;
        allow create: if isValidId(convId) && isValidId(shareId) && isVerifiedUser() &&
          isValidLocationShare(incoming()) &&
          incoming().id == shareId &&
          incoming().conversationId == convId &&
          incoming().userUid == request.auth.uid &&
