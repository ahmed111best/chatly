    // 10. Voice Sticker Packs & Stickers
    match /stickerPacks/{packId} {
      allow get: if isValidId(packId) && isSignedIn() &&
        (existing().isPublic == true || existing().creatorUid == request.auth.uid);
      allow list: if isSignedIn() &&
        (resource.data.isPublic == true || resource.data.creatorUid == request.auth.uid);
      allow create: if isValidId(packId) && isVerifiedUser() &&
        isValidStickerPack(incoming()) &&
        incoming().id == packId &&
        incoming().creatorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(packId) && isVerifiedUser() &&
        existing().creatorUid == request.auth.uid &&
        isValidStickerPack(incoming()) &&
        incoming().id == existing().id &&
        incoming().creatorUid == existing().creatorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'titleAr', 'category', 'isPublic', 'updatedAt']);
      allow delete: if isValidId(packId) && isVerifiedUser() && existing().creatorUid == request.auth.uid;

      match /stickers/{stickerId} {
        allow get: if isValidId(packId) && isValidId(stickerId) && isSignedIn() &&
          (existing().isPublic == true || existing().creatorUid == request.auth.uid);
        allow list: if isSignedIn() &&
          (resource.data.isPublic == true || resource.data.creatorUid == request.auth.uid);
        allow create: if isValidId(packId) && isValidId(stickerId) && isVerifiedUser() &&
          isValidVoiceSticker(incoming()) &&
          incoming().id == stickerId &&
          incoming().packId == packId &&
          incoming().creatorUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/stickerPacks/$(packId));
        allow update: if isValidId(packId) && isValidId(stickerId) && isVerifiedUser() &&
          existing().creatorUid == request.auth.uid &&
          isValidVoiceSticker(incoming()) &&
          incoming().id == existing().id &&
          incoming().packId == existing().packId &&
          incoming().creatorUid == existing().creatorUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'nameAr', 'category', 'kind', 'visualPreset', 'visualUrl',
            'visualMimeType', 'audioUrl', 'audioDurationMs', 'trimStartMs',
            'trimEndMs', 'syncOffsetMs', 'defaultVolume', 'isPublic', 'updatedAt'
          ]);
        allow delete: if isValidId(packId) && isValidId(stickerId) && isVerifiedUser() &&
          existing().creatorUid == request.auth.uid;
      }
    }

    // 11. Stories
    match /stories/{storyId} {
      allow get: if isValidId(storyId) && isSignedIn() &&
        (existing().audience == 'everyone' || existing().userUid == request.auth.uid ||
          exists(/databases/$(database)/documents/users_private/$(existing().userUid)/contacts/$(request.auth.uid)));
      allow list: if isSignedIn() &&
        (resource.data.audience == 'everyone' || resource.data.userUid == request.auth.uid);
      allow create: if isValidId(storyId) && isVerifiedUser() &&
        isValidStory(incoming()) &&
        incoming().id == storyId &&
        incoming().userUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(storyId) && isVerifiedUser() &&
        isValidStory(incoming()) &&
        incoming().id == existing().id &&
        incoming().userUid == existing().userUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['viewUids', 'reactions', 'updatedAt']);
      allow delete: if isValidId(storyId) && isVerifiedUser() && existing().userUid == request.auth.uid;
    }

    // 12. Broadcast Channels
    match /channels/{channelId} {
      allow get: if isValidId(channelId) && isSignedIn() &&
        (existing().isPublic == true || existing().creatorUid == request.auth.uid);
      allow list: if isSignedIn() &&
        (resource.data.isPublic == true || resource.data.creatorUid == request.auth.uid);
      allow create: if isValidId(channelId) && isVerifiedUser() &&
        isValidChannel(incoming()) &&
        incoming().id == channelId &&
        incoming().creatorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(channelId) && isVerifiedUser() &&
        isValidChannel(incoming()) &&
        incoming().id == existing().id &&
        incoming().creatorUid == existing().creatorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            existing().creatorUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['subscriberCount', 'title', 'description', 'updatedAt'])
          ) ||
          (
            (existing().isPublic == true || existing().creatorUid == request.auth.uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['subscriberCount', 'updatedAt'])
          )
        );
      allow delete: if isValidId(channelId) && isVerifiedUser() && existing().creatorUid == request.auth.uid;

      match /members/{memberUid} {
        allow get: if isValidId(channelId) && isValidId(memberUid) && isChannelOwnerOrPublic(channelId);
        allow list: if isSignedIn() &&
          (resource.data.isPublic == true || resource.data.creatorUid == request.auth.uid || resource.data.uid == request.auth.uid);
        allow create: if isValidId(channelId) && isValidId(memberUid) && isVerifiedUser() &&
          isValidChannelMember(incoming()) &&
          incoming().uid == memberUid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isChannelOwnerOrPublic(channelId) &&
          (memberUid == request.auth.uid || incoming().creatorUid == request.auth.uid);
        allow update: if isValidId(channelId) && isValidId(memberUid) && isVerifiedUser() &&
          isValidChannelMember(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/channels/$(channelId)).data.creatorUid == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']);
        allow delete: if isValidId(channelId) && isValidId(memberUid) && isVerifiedUser() &&
          (memberUid == request.auth.uid ||
            get(/databases/$(database)/documents/channels/$(channelId)).data.creatorUid == request.auth.uid);
      }

      match /posts/{postId} {
        allow get: if isValidId(channelId) && isValidId(postId) && isChannelOwnerOrPublic(channelId);
        allow list: if isSignedIn() &&
          (resource.data.isPublic == true || resource.data.authorUid == request.auth.uid);
        allow create: if isValidId(channelId) && isValidId(postId) && isVerifiedUser() &&
          isValidChannelPost(incoming()) &&
          incoming().id == postId &&
          incoming().channelId == channelId &&
          incoming().authorUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/channels/$(channelId)).data.creatorUid == request.auth.uid;
        allow update: if isValidId(channelId) && isValidId(postId) && isVerifiedUser() &&
          isValidChannelPost(incoming()) &&
          incoming().id == existing().id &&
          incoming().channelId == existing().channelId &&
          incoming().authorUid == existing().authorUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isChannelOwnerOrPublic(channelId) &&
          (
            (existing().authorUid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['pinned', 'updatedAt'])) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['viewCount', 'reactions', 'updatedAt'])
          );
        allow delete: if isValidId(channelId) && isValidId(postId) && isVerifiedUser() &&
          existing().authorUid == request.auth.uid;
      }
    }

    // 13. Friend Requests
    match /friendRequests/{reqId} {
      allow get: if isValidId(reqId) && isSignedIn() &&
        (existing().senderUid == request.auth.uid || existing().receiverUid == request.auth.uid);
      allow list: if isSignedIn() &&
        (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow create: if isValidId(reqId) && isVerifiedUser() &&
        isValidFriendRequest(incoming()) &&
        incoming().id == reqId &&
        incoming().senderUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(reqId) && isVerifiedUser() &&
        isValidFriendRequest(incoming()) &&
        existing().status == 'pending' &&
        existing().receiverUid == request.auth.uid &&
        incoming().id == existing().id &&
        incoming().senderUid == existing().senderUid &&
        incoming().receiverUid == existing().receiverUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().status in ['accepted', 'rejected'] &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(reqId) && isVerifiedUser() &&
        (existing().senderUid == request.auth.uid || existing().receiverUid == request.auth.uid);
    }

    // 14. WebRTC Real-Time Call Signaling & History
    match /calls/{callId} {
      allow get: if isValidId(callId) && isSignedIn() &&
        request.auth.uid in existing().participantUids;
      allow list: if isSignedIn() &&
        request.auth.uid in resource.data.participantUids;
      allow create: if isValidId(callId) && isVerifiedUser() &&
        isValidCall(incoming()) &&
        incoming().id == callId &&
        incoming().callerUid == request.auth.uid &&
        request.auth.uid in incoming().participantUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(callId) && isVerifiedUser() &&
        isValidCall(incoming()) &&
        existing().status in ['ringing', 'active'] &&
        request.auth.uid in existing().participantUids &&
        incoming().id == existing().id &&
        incoming().callerUid == existing().callerUid &&
        incoming().calleeUid == existing().calleeUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'answerSdp', 'endedAt', 'updatedAt']) ||
          (
            existing().callerUid == request.auth.uid &&
            existing().offerSdp == '' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['offerSdp', 'updatedAt'])
          )
        );
      allow delete: if false;

      match /candidates/{candId} {
        allow get: if isValidId(callId) && isValidId(candId) && isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participantUids;
        allow list: if isSignedIn() &&
          request.auth.uid in resource.data.participantUids;
        allow create: if isValidId(callId) && isValidId(candId) && isVerifiedUser() &&
          isValidCallCandidate(incoming()) &&
          incoming().id == candId &&
          incoming().senderUid == request.auth.uid &&
          request.auth.uid in incoming().participantUids &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/calls/$(callId));
        allow update, delete: if false;
      }
    }

    // 15. Safety Reports
    match /safetyReports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && existing().reporterUid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.reporterUid == request.auth.uid;
      allow create: if isValidId(reportId) && isVerifiedUser() &&
        isValidSafetyReport(incoming()) &&
        incoming().id == reportId &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(reportId) && isVerifiedUser() &&
        existing().reporterUid == request.auth.uid &&
        isValidSafetyReport(incoming()) &&
        incoming().id == existing().id &&
        incoming().reporterUid == existing().reporterUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'appealNote', 'updatedAt']);
      allow delete: if false;
    }
  }
}
