          isValidContactRelation(incoming()) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().targetUid == existing().targetUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isFavorite', 'isBlocked', 'updatedAt']);
        allow delete: if isValidId(uid) && isValidId(targetUid) && isVerifiedUser() && isOwner(uid);
      }

      match /conversationMeta/{convId} {
