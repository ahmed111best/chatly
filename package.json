{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "dev:frontend": "vite --port 3000 --host 0.0.0.0",
    "start": "vite preview --port 3000 --host 0.0.0.0",
    "build": "vite build",
    "build:frontend": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "package:win": "npm run build:frontend && npm run build:electron && electron-builder --win nsis portable",
    "cap:sync": "npm run build:frontend && npx cap sync android",
    "test": "tsx --test src/core/core.test.ts firestore.rules.test.ts",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "clean": "rm -rf dist release electron/dist electron/*.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase": "^13.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.15.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
