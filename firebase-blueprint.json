        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "channelId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorDisplayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "body": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "pinned": { "type": "boolean" },
        "viewCount": { "type": "number" },
        "reactions": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "channelId", "authorUid", "body", "pinned", "viewCount", "reactions", "createdAt", "updatedAt"]
    },
    "FriendRequestDoc": {
      "title": "FriendRequestDoc",
      "description": "Friend request between two authenticated users.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "receiverUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderUsername": { "type": "string", "maxLength": 40 },
        "senderDisplayName": { "type": "string", "maxLength": 80 },
        "senderAvatarUrl": { "type": "string", "maxLength": 100000 },
        "receiverUsername": { "type": "string", "maxLength": 40 },
        "receiverDisplayName": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "senderUid", "receiverUid", "status", "createdAt", "updatedAt"]
    },
    "CallDoc": {
      "title": "CallDoc",
      "description": "Real-time WebRTC signaling session and call history record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "callerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "calleeUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "callerName": { "type": "string", "maxLength": 80 },
        "calleeName": { "type": "string", "maxLength": 80 },
        "peerUsername": { "type": "string", "maxLength": 40 },
        "callType": { "type": "string", "enum": ["audio", "video", "group"] },
        "status": { "type": "string", "enum": ["ringing", "active", "ended", "missed", "declined"] },
        "offerSdp": { "type": "string", "maxLength": 32000 },
        "answerSdp": { "type": "string", "maxLength": 32000 },
        "participantUids": { "type": "array" },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "callerUid", "calleeUid", "callType", "status", "participantUids", "createdAt", "updatedAt"]
    },
    "CallIceCandidateDoc": {
      "title": "CallIceCandidateDoc",
      "description": "WebRTC ICE candidate exchanged via Firestore real-time listener.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "candidateJson": { "type": "string", "minLength": 2, "maxLength": 4096 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "senderUid", "candidateJson", "createdAt"]
    },
    "SafetyReportDoc": {
      "title": "SafetyReportDoc",
      "description": "User moderation/safety report.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reporterUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["user", "group", "channel", "message"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
        "details": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["open", "reviewing", "resolved", "appealed"] },
        "appealNote": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reporterUid", "targetType", "targetId", "reason", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users_public/{uid}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public profile records searchable by @username without exposing PII."
    },
    "/users_private/{uid}": {
      "schema": { "$ref": "#/entities/UserPrivateAccount" },
      "description": "Owner-only private account data (email, phone, privacy, preferences)."
    },
    "/users_private/{uid}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/DeviceSessionRecord" },
      "description": "Owner-only active/revoked device sessions."
    },
    "/users_private/{uid}/contacts/{targetUid}": {
      "schema": { "$ref": "#/entities/ContactRelation" },
      "description": "Owner-only contact favorite/block state."
    },
    "/users_private/{uid}/conversationMeta/{convId}": {
      "schema": { "$ref": "#/entities/ConversationUserMeta" },
      "description": "Owner-only folders, pins, mute state, and drafts."
    },
    "/users_private/{uid}/savedNotes/{noteId}": {
      "schema": { "$ref": "#/entities/SavedNoteRecord" },
      "description": "Owner-only Saved Vault items."
    },
    "/users_private/{uid}/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/MessageReminderRecord" },
      "description": "Owner-only message reminders."
    },
    "/users_private/{uid}/backups/{backupId}": {
      "schema": { "$ref": "#/entities/EncryptedBackupRecord" },
      "description": "Owner-only client-encrypted backups."
    },
    "/users_private/{uid}/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/NotificationRecord" },
      "description": "Owner-only alerts."
    },
    "/e2eeKeys/{uid}": {
      "schema": { "$ref": "#/entities/E2eePublicKeyRecord" },
      "description": "Public ECDH keys for E2EE direct chats."
    },
    "/conversations/{convId}": {
      "schema": { "$ref": "#/entities/ConversationDoc" },
      "description": "Direct and group conversation rooms."
    },
    "/conversations/{convId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/ConversationMember" },
      "description": "Membership & roles inside conversations."
    },
    "/conversations/{convId}/messages/{msgId}": {
      "schema": { "$ref": "#/entities/ChatMessageDoc" },
      "description": "Real-time messages inside a conversation."
    },
    "/conversations/{convId}/typing/{uid}": {
      "schema": { "$ref": "#/entities/TypingStateDoc" },
      "description": "Real-time typing indicators inside a conversation."
    },
    "/conversations/{convId}/locations/{shareId}": {
      "schema": { "$ref": "#/entities/LocationShareDoc" },
      "description": "Real-time live location shares."
    },
    "/conversations/{convId}/polls/{pollId}": {
      "schema": { "$ref": "#/entities/GroupPollDoc" },
      "description": "Group polls."
    },
    "/conversations/{convId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/GroupEventDoc" },
      "description": "Group events."
    },
    "/conversations/{convId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/GroupTaskDoc" },
      "description": "Group tasks."
    },
    "/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaDoc" },
      "description": "Uploaded media items stored below 1MB."
    },
    "/stickerPacks/{packId}": {
      "schema": { "$ref": "#/entities/StickerPackDoc" },
      "description": "Voice Sticker packs."
    },
    "/stickerPacks/{packId}/stickers/{stickerId}": {
      "schema": { "$ref": "#/entities/VoiceStickerDoc" },
      "description": "Voice Stickers inside a pack."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/StoryDoc" },
      "description": "24h expiring stories."
    },
    "/channels/{channelId}": {
      "schema": { "$ref": "#/entities/ChannelDoc" },
      "description": "Public and private broadcast channels."
    },
    "/channels/{channelId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/ChannelMemberDoc" },
      "description": "Channel subscribers and roles."
    },
    "/channels/{channelId}/posts/{postId}": {
      "schema": { "$ref": "#/entities/ChannelPostDoc" },
      "description": "Channel broadcast posts."
    },
    "/friendRequests/{reqId}": {
      "schema": { "$ref": "#/entities/FriendRequestDoc" },
      "description": "Friend requests between users."
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallDoc" },
      "description": "WebRTC call signaling & history."
    },
    "/calls/{callId}/candidates/{candId}": {
      "schema": { "$ref": "#/entities/CallIceCandidateDoc" },
      "description": "ICE candidates for active WebRTC calls."
